# Keep all impl classes referenced via JNI.
-keep class com.android.nfcstm.dhimpl**.*Native* { *; }
# Keep NfcCharging class since it's usage is behind a trunk stable flag (which is disabled in `-next` config).
-keep class com.android.nfcstm.wlc.NfcCharging { *; }
-keep class com.android.nfcstm.NfcVendorNciResponse { *; }
-keep class com.android.nfcstm.proto.** { *; }
